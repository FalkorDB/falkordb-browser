{
  "name": "falkordb-browser-mobile",
  "author": "FalkorDB",
  "description": "FalkorDB Browser iOS and Android app",
  "version": "2.6.0",
  "private": true,
  "scripts": {
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "dev:android": "sh scripts/dev-android.sh",
    "deploy:aws": "sh aws/deploy.sh",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "typescript": "^6.0.3",
    "@types/node": "^24.9.0"
  }
}
