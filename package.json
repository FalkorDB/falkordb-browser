    "next-themes": "^0.4.6",
    "preact": "^11.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-gtm-module": "^2.0.11",
    "react-json-tree": "^0.20.0",
    "react-resizable-panels": "^4.14.5",
    "swagger-ui-react": "^5.33.3",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.3",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
