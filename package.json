    "@types/swagger-ui-react": "^5.18.0",
    "antlr4ng-cli": "2.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "playwright": "^1.61.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "lodash": "^4.18.0",
    "ajv": "^6.14.0",
    "zod-validation-error": "^4.0.0",
    "react-json-view": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "swagger-ui-react": {
